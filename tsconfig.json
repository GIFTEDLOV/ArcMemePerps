{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@arcmemeperps/shared": ["packages/shared/src/index.ts"],
      "@arcmemeperps/domain": ["packages/domain/src/index.ts"],
      "@arcmemeperps/chain-adapters": ["packages/chain-adapters/src/index.ts"],
      "@arcmemeperps/lifecycle": ["packages/lifecycle/src/index.ts"],
      "@arcmemeperps/risk-engine": ["packages/risk-engine/src/index.ts"],
      "@arcmemeperps/oracle": ["packages/oracle/src/index.ts"],
      "@arcmemeperps/qualification-proof": ["packages/qualification-proof/src/index.ts"],
      "@arcmemeperps/providers": ["packages/providers/src/index.ts"],
      "@arcmemeperps/simulator": ["packages/simulator/src/index.ts"],
      "@arcmemeperps/market-depth": ["packages/market-depth/src/index.ts"],
      "@arcmemeperps/persistence": ["packages/persistence/src/index.ts"],
      "@arcmemeperps/intelligence": ["packages/intelligence/src/index.ts"],
      "@arcmemeperps/backend-runtime": ["packages/backend-runtime/src/index.ts"],
      "@arcmemeperps/api-contracts": ["packages/api-contracts/src/index.ts"],
      "@arcmemeperps/keeper": ["apps/keeper/src/index.ts"],
      "@arcmemeperps/reporter": ["apps/reporter/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "fixtures/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "out", "cache"]
}
