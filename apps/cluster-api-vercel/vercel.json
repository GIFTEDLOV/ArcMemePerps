{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": { "api/index.ts": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/health", "destination": "/api/index?route=health" },
    { "source": "/api/v1/:path*", "destination": "/api/index?route=:path*" }
  ]
}
