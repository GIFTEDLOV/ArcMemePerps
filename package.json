{
  "name": "arc-meme-perps",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Backend, risk, qualification, and Arc contract foundation for ArcMemePerps.",
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "allowBuilds": {
      "esbuild": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --filter @arcmemeperps/api dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "forge:test": "forge test",
    "market:inspect": "tsx apps/api/src/cli.ts",
    "test:live": "tsx apps/api/src/live-smoke.ts",
    "deploy:dry-run": "tsx scripts/dry-run-testnet.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.0",
    "viem": "^2.37.0"
  }
}
