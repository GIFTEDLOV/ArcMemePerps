# Arc network configuration. No credentials are committed here.
ARCMEMEPERPS_DEPLOYMENT_NETWORK=MAINNET
ARC_TESTNET_RPC_URL=
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_CHAIN_ID=5042002
ARC_MAINNET_CHAIN_ID=5042
ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_MAINNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_MAINNET_EXPLORER_URL=https://explorer.arc.io
RISK_RULE_VERSION=0.4.0

# Mainnet remains pending until the funded, one-shot ceremony writes these
# values. Empty values are intentional; they must never fall back to Testnet.
MAINNET_DEPLOYMENT_ID=arc-mainnet-pending
MAINNET_START_BLOCK=
MAINNET_DATABASE_PATH=
DISCOVERY_DATABASE_PATH=evidence/winner-rebuild/winner.sqlite
DISCOVERY_SNAPSHOT_PATH=evidence/winner-rebuild/discovery-snapshot.json
API_ALLOWED_ORIGIN=
MAINNET_MARKET_REGISTRY=
MAINNET_QUALIFICATION_REGISTRY=
MAINNET_ORACLE_ROUTER=
MAINNET_RISK_CONFIG=
MAINNET_USDC_MARGIN_VAULT=
MAINNET_PERP_ENGINE=
MAINNET_INSURANCE_FUND=
MAINNET_PUBLIC_LP_VAULT=
MAINNET_ADL_CONTROLLER=
MAINNET_PROTOCOL_TIMELOCK=
MAINNET_GOVERNANCE_SAFE=
MAINNET_QUALIFICATION_OPERATOR=
MAINNET_RISK_OPERATOR=
MAINNET_ORACLE_ADMIN=
MAINNET_ORACLE_REPORTER_1=
MAINNET_ORACLE_REPORTER_2=
MAINNET_ORACLE_REPORTER_3=
MAINNET_KEEPER=
MAINNET_EMERGENCY_AUTHORITY=
MAINNET_INSURANCE_MANAGER=
MAINNET_LP_RISK_CONTROLLER=
MAINNET_TREASURY_FEE_RECIPIENT=
MAINNET_TIMELOCK_DELAY_SECONDS=
MAINNET_ORACLE_MAX_AGE_SECONDS=
MAINNET_ORACLE_MIN_CONFIDENCE_BPS=
MAINNET_PUBLIC_LP_DELAY_SECONDS=

